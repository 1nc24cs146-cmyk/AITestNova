{
  "activationEvents": [
    "onView:aitestnova.main",
    "onCommand:aitestnova.open",
    "onCommand:aitestnova.generateFunction",
    "onCommand:aitestnova.generateFile",
    "onCommand:aitestnova.recordApi",
    "onCommand:aitestnova.replayAll",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:go",
    "onCommand:aitestnova.runUnitStability",
    "onCommand:aitestnova.setAiApiKey",
    "onCommand:aitestnova.clearAiApiKey",
    "onCommand:aitestnova.addCIWorkflow",
    "onCommand:aitestnova.setCoverageBaseline",
    "onCommand:aitestnova.generateFromSelection",
    "onCommand:aitestnova.importTests",
    "onCommand:aitestnova.exportTests",
    "onCommand:aitestnova.commitTests",
    "onCommand:aitestnova.createPRDescription",
    "onCommand:aitestnova.checkStaleTests",
    "onCommand:aitestnova.runMutationScore",
    "onCommand:aitestnova.quarantineFlakyTests",
    "onCommand:aitestnova.showTrends",
    "onCommand:aitestnova.saveGeneratedTest",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:rust",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:kotlin",
    "onLanguage:swift",
    "onCommand:aitestnova.generateForUncoveredLines",
    "onCommand:aitestnova.generateForSurvivingMutants"
  ],
  "author": "NitinKumar Hiremath",
  "categories": [
    "Testing",
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aitestnova.open",
        "title": "AITestNova: Open"
      },
      {
        "command": "aitestnova.generateFunction",
        "title": "AITestNova: Generate Test for This Function"
      },
      {
        "command": "aitestnova.generateFile",
        "title": "AITestNova: Generate Tests for This File"
      },
      {
        "command": "aitestnova.recordApi",
        "title": "AITestNova: Record API Test"
      },
      {
        "command": "aitestnova.replayAll",
        "title": "AITestNova: Replay Recorded API Tests"
      },
      {
        "command": "aitestnova.runStableCheck",
        "title": "AITestNova: Stability Check (Run 5 Times)"
      },
      {
        "command": "aitestnova.runUnitStability",
        "title": "AITestNova: Run Unit Tests Stability Check"
      },
      {
        "command": "aitestnova.setAiApiKey",
        "title": "AITestNova: Set AI API Key"
      },
      {
        "command": "aitestnova.clearAiApiKey",
        "title": "AITestNova: Clear AI API Key"
      },
      {
        "command": "aitestnova.addCIWorkflow",
        "title": "AITestNova: Add CI Workflow"
      },
      {
        "command": "aitestnova.setCoverageBaseline",
        "title": "AITestNova: Set Coverage Baseline"
      },
      {
        "command": "aitestnova.generateFromSelection",
        "title": "AITestNova: Generate Tests from Selected Comment/Spec"
      },
      {
        "command": "aitestnova.importTests",
        "title": "AITestNova: Import API Tests"
      },
      {
        "command": "aitestnova.exportTests",
        "title": "AITestNova: Export API Tests"
      },
      {
        "command": "aitestnova.commitTests",
        "title": "AITestNova: Commit Generated Tests (Local Git)"
      },
      {
        "command": "aitestnova.createPRDescription",
        "title": "AITestNova: Create PR Description"
      },
      {
        "command": "aitestnova.checkStaleTests",
        "title": "AITestNova: Check Stale Tests"
      },
      {
        "command": "aitestnova.runMutationScore",
        "title": "AITestNova: Run Mutation Score"
      },
      {
        "command": "aitestnova.quarantineFlakyTests",
        "title": "AITestNova: Quarantine Flaky Tests"
      },
      {
        "command": "aitestnova.showTrends",
        "title": "AITestNova: Show Trends"
      },
      {
        "command": "aitestnova.saveGeneratedTest",
        "title": "AITestNova: Save Generated Test to Its Test File"
      },
      {
        "command": "aitestnova.generateForUncoveredLines",
        "title": "AITestNova: Generate Tests for Uncovered Lines"
      },
      {
        "command": "aitestnova.generateForSurvivingMutants",
        "title": "AITestNova: Generate Tests to Kill Surviving Mutants"
      }
    ],
    "configuration": {
      "properties": {
        "aitestnova.aiProvider": {
          "default": "template",
          "description": "Template needs no model. Ollama uses a local model. OpenAI uses an OpenAI-compatible API with a key saved in the OS keychain.",
          "enum": [
            "template",
            "ollama",
            "openai"
          ],
          "type": "string"
        },
        "aitestnova.ollamaModel": {
          "default": "qwen2.5-coder:7b",
          "description": "Ollama model used for test generation.",
          "type": "string"
        },
        "aitestnova.ollamaUrl": {
          "default": "http://localhost:11434",
          "description": "Ollama base URL.",
          "type": "string"
        },
        "aitestnova.stabilityRuns": {
          "default": 5,
          "description": "How many times a recorded test is replayed in a stability check.",
          "type": "number"
        },
        "aitestnova.openaiBaseUrl": {
          "default": "https://api.openai.com/v1",
          "description": "Base URL for the OpenAI-compatible provider.",
          "type": "string"
        },
        "aitestnova.openaiModel": {
          "default": "gpt-4o-mini",
          "description": "Model for the OpenAI-compatible provider.",
          "type": "string"
        },
        "aitestnova.javaFramework": {
          "default": "junit",
          "description": "Java test framework for generated tests.",
          "enum": [
            "junit",
            "testng"
          ],
          "type": "string"
        },
        "aitestnova.testCommand": {
          "default": "",
          "description": "Test command for unit stability runs. Leave blank to auto-detect (npm test, pytest, go test, mvn test).",
          "type": "string"
        },
        "aitestnova.aiModels": {
          "default": "",
          "description": "Comma-separated models to try for test generation (max 3). The best-scoring output wins. Leave blank to use the single ollamaModel / openaiModel.",
          "type": "string"
        },
        "aitestnova.mutationLimit": {
          "default": 8,
          "description": "Maximum mutants to run for a mutation score. Each mutant temporarily swaps one operator in the file, runs the test command, then restores the file.",
          "type": "number"
        },
        "aitestnova.testFramework": {
          "type": "string",
          "enum": [
            "auto",
            "jest",
            "vitest",
            "mocha",
            "node",
            "jasmine"
          ],
          "default": "auto",
          "description": "JavaScript test runner for generated tests. 'auto' reads the project's package.json and config files (Vitest, Jest, Mocha, Jasmine, Node test runner), defaulting to Jest."
        }
      },
      "title": "AITestNova"
    },
    "views": {
      "aitestnova": [
        {
          "id": "aitestnova.main",
          "name": "AITestNova"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "icon": "media/aitestnova.svg",
          "id": "aitestnova",
          "title": "AITestNova"
        }
      ]
    }
  },
  "description": "Generate unit tests, record and replay API calls with mocks, run test suites, check coverage, and see a local dashboard \u2014 in Antigravity. Multi-model test generation, stability checks, and CI workflow included.",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.26.0",
    "typescript": "^5.0.0"
  },
  "displayName": "AITestNova",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "keywords": [
    "test",
    "testing",
    "unit-test",
    "api",
    "record",
    "replay",
    "mock",
    "coverage",
    "antigravity",
    "aitestnova"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "aitestnova",
  "publisher": "nitinkumarhiremath",
  "repository": {
    "type": "git",
    "url": "https://github.com/1nc24cs146-cmyk/AITestNova"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package"
  },
  "version": "0.4.1"
}
